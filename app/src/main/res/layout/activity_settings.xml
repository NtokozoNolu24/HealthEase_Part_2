<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/settings_heading"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Personalise your HealthEase experience"
            android:textColor="@color/settings_body"
            android:textSize="14sp" />

        <!-- Language -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Language and Region"
            android:textColor="@color/settings_heading"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/settings_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App language"
                android:textColor="@color/settings_heading"
                android:textStyle="bold"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/spLanguage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Appearance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appearance"
            android:textColor="@color/settings_heading"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/settings_card">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDarkMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark mode"
                android:textColor="@color/settings_heading"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Notifications -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textColor="@color/settings_heading"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/settings_card">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enable_notifications"
                android:textColor="@color/settings_heading"
                android:padding="8dp"
                android:checked="true" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchMedication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/medication_reminders"
                android:textColor="@color/settings_heading"
                android:padding="8dp"
                android:checked="true" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAppointments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/appointment_reminders"
                android:textColor="@color/settings_heading"
                android:padding="8dp"
                android:checked="true" />
        </LinearLayout>

        <!-- Accessibility -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility"
            android:textColor="@color/settings_heading"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/settings_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Text size"
                android:textColor="@color/settings_heading"
                android:textStyle="bold"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/spTextSize"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:entries="@array/text_size_options" />

        </LinearLayout>

        <!-- Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Information"
            android:textColor="@color/settings_heading"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/settings_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privacy and Security"
                android:textColor="@color/settings_heading"
                android:textSize="15sp"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About HealthEase"
                android:textColor="@color/settings_heading"
                android:textSize="15sp"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save_changes" />

        <!-- Back -->
        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/back" />

    </LinearLayout>
</ScrollView>


